<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- The join page reads a table's QR code with the camera. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Android 16 and later gate the local network. Without these an app can
       reach the internet but not the phones on the Wi-Fi, and neither can they
       reach it: the exact fault that makes a table server unreachable.
       NEARBY_WIFI_DEVICES is the Android 16 name, ACCESS_LOCAL_NETWORK the
       Android 17 one; both are declared so one APK serves both. -->
  <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
      android:usesPermissionFlags="neverForLocation"
      tools:targetApi="tiramisu" />
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:usesCleartextTraffic="true"
      android:theme="@style/TableTheme">

    <!-- A launcher icon has room for about twelve characters, so the icon
         carries the short name and everything else the whole one.

         singleTop, because the chooser is asked for again and again: the
         notification, the launcher, and "host this table" from the tools all
         point at it. Without it each ask built another chooser on top of the
         last, each with a WebView of its own, and back walked down through
         them one at a time. -->
    <activity android:name=".MainActivity" android:exported="true"
        android:launchMode="singleTop"
        android:label="@string/launcher_name">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Also singleTop: the table is opened by address, and opening the one
         already on screen hands it the address instead of building a second. -->
    <activity android:name=".TableActivity" android:exported="false"
        android:launchMode="singleTop"
        android:configChanges="orientation|screenSize|keyboardHidden" />

    <!-- The node runtime cannot be stopped and started again inside one
         process, so stopping the table means ending the process it runs in.
         It gets a process of its own: the table stops, the app stays up, and
         the next table starts a fresh runtime. -->
    <service android:name=".NodeService" android:exported="false"
        android:process=":node"
        android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Runs the table the other players connect to" />
    </service>
  </application>
</manifest>
