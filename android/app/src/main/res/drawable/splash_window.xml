<?xml version="1.0" encoding="utf-8"?>
<!-- What the phone draws the instant the icon is tapped, before a line of our
     code runs. Android 12 and later draw their own splash instead, from the
     windowSplashScreen items in values-v31.

     Cream and the boat, which is the launcher icon and the mark the pages
     carry: tapping the icon should open the icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:drawable="@color/cream" />
  <item android:drawable="@drawable/boat_mark" android:gravity="center"
      android:width="282dp" android:height="282dp" />
</layer-list>
